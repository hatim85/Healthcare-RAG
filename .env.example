# ==============================================================================
# Healthcare Clinical RAG - Production Environment Configuration Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=info
PORT=8000
WEB_CONCURRENCY=4

# ------------------------------------------------------------------------------
# 2. Database & Multi-Tenancy (PostgreSQL Shared Cluster or SQLite Dev)
# ------------------------------------------------------------------------------
# Production PostgreSQL (Required for multi-node / Kubernetes deployments)
DATABASE_URL=postgresql+psycopg2://healthcare:healthcare_secure_pass@localhost:5432/healthcare_db
DATABASE_URL_POOLED=postgresql+psycopg2://healthcare:healthcare_secure_pass@localhost:5432/healthcare_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Development fallback (single-node):
# DATABASE_URL=sqlite:///data/document_registry.db

# ------------------------------------------------------------------------------
# 3. Redis (Cache, Rate Limiting & Celery Broker)
# ------------------------------------------------------------------------------
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your-redis-password
REDIS_URL=redis://default:your-redis-password@your-redis-host:6379/0
REDIS_CACHE_PREFIX=healthcare
ANSWER_CACHE_ENABLED=true
ANSWER_CACHE_TTL_SECONDS=7200

# Rate Limiting Thresholds (Requests per minute per client/tenant)
RATE_LIMIT_ASK_RPM=60
RATE_LIMIT_UPLOAD_RPM=20

# ------------------------------------------------------------------------------
# 4. Celery Distributed Worker Queue
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://default:your-redis-password@your-redis-host:6379/0
CELERY_RESULT_BACKEND=redis://default:your-redis-password@your-redis-host:6379/0
CELERY_CONCURRENCY=4
INGESTION_MAX_WORKERS=4
INGESTION_BATCH_SIZE=64
INGESTION_MAX_RETRIES=3
INGESTION_RETRY_DELAY_SECONDS=2

# ------------------------------------------------------------------------------
# 5. Qdrant Vector Search Engine
# ------------------------------------------------------------------------------
QDRANT_COLLECTION_NAME=Healthcare
# For Qdrant Cloud:
QDRANT_URL=https://your-cluster-id.eu-central-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-cloud-api-key

# ------------------------------------------------------------------------------
# 6. LLM Gateway & Provider API Keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_production_api_key
GROQ_MODEL=gpt-oss-20b
PROMPT_GUARD=hf_your_huggingface_token
LITELLM_API_BASE=http://127.0.0.1:4000
LITELLM_SALT_KEY=sk-healthcare-salt-key
LITELLM_DB_PASSWORD=change-to-a-secure-random-password
LITELLM_VIRTUAL_KEY=sk-your-litellm-virtual-key
LITELLM_MODEL=gpt-oss-20b

# ------------------------------------------------------------------------------
# 7. Authentication, RBAC & Multi-Tenancy
# ------------------------------------------------------------------------------
AUTH_ENABLED=true
JWT_SECRET_KEY=change-to-a-cryptographically-secure-random-256bit-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
API_KEYS=production-clinician-key-1,production-admin-key-2
ADMIN_API_KEY=production-admin-key-2

# Initial Default Credentials (Change on first deploy)
ADMIN_PASSWORD=change_admin_password_123
CLINICIAN_PASSWORD=change_clinician_password_123
RESEARCHER_PASSWORD=change_researcher_password_123

# ------------------------------------------------------------------------------
# 8. Observability & HIPAA Audit Trail
# ------------------------------------------------------------------------------
OBSERVABILITY_LOG_DIR=logs
OBSERVABILITY_EVENTS_FILE=observability_events.jsonl
AUDIT_LOG_DIR=logs
AUDIT_LOG_FILE=audit_trail.jsonl

# ------------------------------------------------------------------------------
# 9. Circuit Breaker Settings
# ------------------------------------------------------------------------------
CIRCUIT_BREAKER_FAIL_MAX=5
CIRCUIT_BREAKER_RESET_TIMEOUT=30.0

# ------------------------------------------------------------------------------
# 10. Corpus & Retrieval Versioning
# ------------------------------------------------------------------------------
RAG_CORPUS_VERSION=v1
RAG_CORPUS_VERSION_FILE=data/corpus_version.json
ANSWER_PROMPT_VERSION=v1
ANSWER_RETRIEVAL_VERSION=hybrid-rrf-v1
ANSWER_ACCESS_SCOPE=local

# ------------------------------------------------------------------------------
# 11. Langfuse LLM Observability & Distributed Tracing
# ------------------------------------------------------------------------------
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-your-langfuse-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-langfuse-secret-key
# LANGFUSE_HOST is used by docker-compose and app code:
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_SALT=change-to-a-random-256bit-hex-string
LANGFUSE_BASE64_KEY=base64-encoded-pk:sk-pair
LANGFUSE_THREADS=2
LANGFUSE_MAX_RETRIES=3
LANGFUSE_TIMEOUT=5.0

# ------------------------------------------------------------------------------
# 12. Multi-Provider MCP Client Configuration
# ------------------------------------------------------------------------------
# Master toggle for MCP client connections on app startup
MCP_CLIENTS_ENABLED=true

# Per-provider toggles (true/false)
MCP_LANGFUSE_ENABLED=true
MCP_QDRANT_ENABLED=true
MCP_FIRECRAWL_ENABLED=true
MCP_GROQ_ENABLED=true
MCP_LITELLM_ENABLED=true
MCP_REDIS_ENABLED=true

# Firecrawl credentials (enable MCP_FIRECRAWL_ENABLED and set key)
FIRECRAWL_API_KEY=fc-your-firecrawl-api-key
